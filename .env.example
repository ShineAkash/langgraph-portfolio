# Copy this file to `.env` and fill in your real keys.
# Never commit the real `.env` — it is already in `.gitignore`.

# Used by most projects (langchain_groq)
GROQ_API_KEY=your_groq_api_key_here

# Groq model used by the Python projects. Set this to any currently supported
# model ID from your Groq account, for example: openai/gpt-oss-120b.
GROQ_MODEL=openai/gpt-oss-120b

# Optional overrides for project 08. When unset, both use GROQ_MODEL.
# GROQ_GENERATION_MODEL=openai/gpt-oss-20b
# GROQ_EVALUATION_MODEL=openai/gpt-oss-120b

# Used by project 02 (simple LLM QA via OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
